# Copy to .env and fill in. Never commit .env.

# Password for the web dashboard (required, 12+ characters).
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Where to listen. Keep 127.0.0.1 unless it sits behind an HTTPS reverse proxy.
HOST=127.0.0.1
PORT=8787

# Set to true when served over HTTPS so the session cookie is Secure-only.
COOKIE_SECURE=false
# Set to true behind a reverse proxy (Caddy/nginx) so login rate limiting sees real client IPs.
TRUST_PROXY=false

# Directory for posts, uploads and the renewed token.
DATA_DIR=./data

# Public https:// address of this server. Needed in live mode for UPLOADED files,
# because Instagram downloads media from <PUBLIC_URL>/media/... (pasted links work without it).
PUBLIC_URL=
# Your domain, used by docker-compose/Caddy to get an HTTPS certificate (e.g. posts.example.com).
DOMAIN=
# Largest video upload, in MB.
MAX_VIDEO_MB=300

# --- Instagram (Business or Creator account) ---
# Leave DRY_RUN=true until you've tested. With dry run on, nothing is sent to Instagram.
DRY_RUN=true
IG_USER_ID=
IG_ACCESS_TOKEN=
# graph.instagram.com is recommended: its token renews itself automatically (free).
# graph.facebook.com for "Instagram API with Facebook Login".
IG_GRAPH_HOST=graph.instagram.com
IG_API_VERSION=v23.0
