# systemd unit for running without Docker.
# Copy the scheduler/ folder to /opt/biscuit-scheduler, create .env there, then:
#   sudo useradd --system --home /opt/biscuit-scheduler biscuit
#   sudo chown -R biscuit: /opt/biscuit-scheduler
#   sudo cp biscuit-scheduler.service /etc/systemd/system/
#   sudo systemctl enable --now biscuit-scheduler
[Unit]
Description=BISCUIT Post Scheduler
After=network-online.target
Wants=network-online.target

[Service]
User=biscuit
WorkingDirectory=/opt/biscuit-scheduler
ExecStart=/usr/bin/env node --env-file=.env server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/biscuit-scheduler/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
